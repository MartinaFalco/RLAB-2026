# ---------------------------------------------------------------------------
# Configuracion del frontend (copiar a .env y ajustar)
# Todas las variables expuestas al browser deben empezar con VITE_
# ---------------------------------------------------------------------------

# Modo de enlace con el simulador:
#   mock      -> telemetria simulada en el browser (no requiere backend)
#   websocket -> se conecta al gateway que corre en la Raspberry Pi / PC central
VITE_LINK_MODE=mock

# URL del WebSocket del gateway (solo se usa con VITE_LINK_MODE=websocket)
# Desarrollo local:  ws://localhost:8000/ws
# Produccion (TLS):  wss://simulador.unahur.edu.ar/ws
VITE_WS_URL=ws://localhost:8000/ws

# Token de sesion enviado al gateway al abrir el WebSocket.
# En produccion este token lo entrega la plataforma R-Lab al reservar el turno.
VITE_SESSION_TOKEN=

# Streams de video de las camaras (dejar vacio para mostrar el placeholder).
# Acepta local:<nombre>#<indice>, MJPEG (<img>) o un player embebible (<iframe>).
# Si el valor contiene #, encerrarlo entre comillas (ej.: "local:Brio#0").
VITE_CAM_1=
VITE_CAM_2=
VITE_CAM_3=
VITE_CAM_4=

# Resolucion maxima solicitada para las camaras locales (ideal: 320x240).
# Valores predeterminados: 320x240.
VITE_CAM_WIDTH=320
VITE_CAM_HEIGHT=240

# Ajuste opcional para cámaras locales: giro horario en grados (ej.: -6, 3.5, 90)
# y zoom multiplicador. La rotación cubre automáticamente el recuadro.
# Valores predeterminados: rotación 0 y zoom 1.
VITE_CAM_1_ROTATE=0
VITE_CAM_2_ROTATE=0
VITE_CAM_3_ROTATE=0
VITE_CAM_4_ROTATE=0
VITE_CAM_1_ZOOM=1
VITE_CAM_2_ZOOM=1
VITE_CAM_3_ZOOM=1
VITE_CAM_4_ZOOM=1

# Modo de operacion por defecto que muestra la interfaz: asistido | autonomo
VITE_DEFAULT_MODE=asistido
